@@ -0,0 +1,192 @@
+import React, { useEffect, useRef } from 'react';
+
+interface HeroAICanvasProps {
+  className?: string;
+}
+
+interface Particle {
+  x: number;
+  y: number;
+  vx: number;
+  vy: number;
+  radius: number;
+}
+
+function HeroAICanvas({ className = '' }: HeroAICanvasProps) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+
+    const context = canvas.getContext('2d');
+    if (!context) return;
+
+    let animationId = 0;
+    let width = 0;
+    let height = 0;
+    let dpr = 1;
+    let frame = 0;
+    let particles: Particle[] = [];
+    let connectionDistance = 150;
+    let reducedMotion = false;
+
+    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const pointer = { x: -9999, y: -9999, active: false };
+
+    const createParticles = () => {
+      const particleCount = Math.min(
+        110,
+        Math.max(48, Math.floor((width * height) / 24000))
+      );
+      particles = Array.from({ length: particleCount }).map(() => ({
+        x: Math.random() * width,
+        y: Math.random() * height,
+        vx: (Math.random() - 0.5) * 0.4,
+        vy: (Math.random() - 0.5) * 0.4,
+        radius: 1.2 + Math.random() * 2.4,
+      }));
+      connectionDistance = Math.max(110, Math.min(180, width * 0.15));
+    };
+
+    const resize = () => {
+      const rect = canvas.getBoundingClientRect();
+      dpr = Math.min(window.devicePixelRatio || 1, 2);
+      width = rect.width;
+      height = rect.height;
+      canvas.width = Math.max(1, Math.floor(width * dpr));
+      canvas.height = Math.max(1, Math.floor(height * dpr));
+      context.setTransform(dpr, 0, 0, dpr, 0, 0);
+      createParticles();
+    };
+
+    const drawScanBand = () => {
+      const scanX = ((frame * 0.42) % (width + 260)) - 130;
+      const gradient = context.createLinearGradient(scanX - 90, 0, scanX + 90, 0);
+      gradient.addColorStop(0, 'rgba(58, 148, 255, 0)');
+      gradient.addColorStop(0.5, 'rgba(58, 148, 255, 0.1)');
+      gradient.addColorStop(1, 'rgba(58, 148, 255, 0)');
+      context.fillStyle = gradient;
+      context.fillRect(scanX - 110, 0, 220, height);
+    };
+
+    const drawConnections = () => {
+      const maxDistanceSq = connectionDistance * connectionDistance;
+      for (let i = 0; i < particles.length; i += 1) {
+        const p1 = particles[i];
+        for (let j = i + 1; j < particles.length; j += 1) {
+          const p2 = particles[j];
+          const dx = p1.x - p2.x;
+          const dy = p1.y - p2.y;
+          const distSq = dx * dx + dy * dy;
+          if (distSq > maxDistanceSq) continue;
+
+          const ratio = 1 - distSq / maxDistanceSq;
+          context.strokeStyle = `rgba(146, 198, 255, ${0.03 + ratio * 0.13})`;
+          context.lineWidth = 0.7;
+          context.beginPath();
+          context.moveTo(p1.x, p1.y);
+          context.lineTo(p2.x, p2.y);
+          context.stroke();
+        }
+      }
+    };
+
+    const updateAndDrawParticles = () => {
+      for (let i = 0; i < particles.length; i += 1) {
+        const p = particles[i];
+
+        p.x += p.vx;
+        p.y += p.vy;
+
+        if (p.x <= -10 || p.x >= width + 10) p.vx *= -1;
+        if (p.y <= -10 || p.y >= height + 10) p.vy *= -1;
+
+        if (pointer.active) {
+          const dx = pointer.x - p.x;
+          const dy = pointer.y - p.y;
+          const distSq = dx * dx + dy * dy;
+          if (distSq < 160 * 160 && distSq > 0) {
+            const force = 0.00008;
+            p.vx += dx * force;
+            p.vy += dy * force;
+            p.vx = Math.max(-0.65, Math.min(0.65, p.vx));
+            p.vy = Math.max(-0.65, Math.min(0.65, p.vy));
+          }
+        }
+
+        context.beginPath();
+        context.fillStyle = 'rgba(220, 238, 255, 0.65)';
+        context.shadowBlur = 8;
+        context.shadowColor = 'rgba(137, 191, 255, 0.22)';
+        context.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
+        context.fill();
+      }
+      context.shadowBlur = 0;
+    };
+
+    const drawFrame = () => {
+      frame += 1;
+      context.clearRect(0, 0, width, height);
+      drawScanBand();
+      drawConnections();
+      updateAndDrawParticles();
+
+      if (!reducedMotion) {
+        animationId = window.requestAnimationFrame(drawFrame);
+      }
+    };
+
+    const updateMotionPreference = () => {
+      reducedMotion = prefersReducedMotion.matches;
+      if (reducedMotion) {
+        window.cancelAnimationFrame(animationId);
+        drawFrame();
+        return;
+      }
+      window.cancelAnimationFrame(animationId);
+      animationId = window.requestAnimationFrame(drawFrame);
+    };
+
+    const onMouseMove = (event: MouseEvent) => {
+      const rect = canvas.getBoundingClientRect();
+      pointer.x = event.clientX - rect.left;
+      pointer.y = event.clientY - rect.top;
+      pointer.active = true;
+    };
+
+    const onMouseLeave = () => {
+      pointer.active = false;
+      pointer.x = -9999;
+      pointer.y = -9999;
+    };
+
+    resize();
+    updateMotionPreference();
+
+    window.addEventListener('resize', resize);
+    window.addEventListener('mousemove', onMouseMove);
+    window.addEventListener('mouseout', onMouseLeave);
+    if (typeof prefersReducedMotion.addEventListener === 'function') {
+      prefersReducedMotion.addEventListener('change', updateMotionPreference);
+    } else {
+      prefersReducedMotion.addListener(updateMotionPreference);
+    }
+
+    return () => {
+      window.cancelAnimationFrame(animationId);
+      window.removeEventListener('resize', resize);
+      window.removeEventListener('mousemove', onMouseMove);
+      window.removeEventListener('mouseout', onMouseLeave);
+      if (typeof prefersReducedMotion.removeEventListener === 'function') {
+        prefersReducedMotion.removeEventListener('change', updateMotionPreference);
+      } else {
+        prefersReducedMotion.removeListener(updateMotionPreference);
+      }
+    };
+  }, []);
+
+  return <canvas ref={canvasRef} className={className} aria-hidden="true" />;
+}
+
+export default HeroAICanvas;

